#!/usr/bin/env bash
# Stage the standard Omarchy screenshot scene on WS 7 and leave it up for a
# human to raise the paint overlay over and photograph.
#
#   bin/shoot              stage workspace 7 and leave it standing
#   bin/shoot --teardown   close what a previous run staged
#
# THE SCENE IS THE ONE EVERY OMARCHY THEME SHIPS: Neovim on the left, btop
# top-right, the Files app bottom-right, a terminal with a directory listing
# bottom-left. A theme screenshot is a genre, and a reader flipping through
# themes compares like with like — so the overlay is photographed floating
# over the same desk a reader has already seen twenty times, which is what
# makes the paint cards read as the new thing in the picture. Three of the
# four tiles are terminals, so three of them grow cards.
#
# The four windows are FLOATED and placed at the reference proportions rather
# than left to the tiler: the first attempt trusted the layout engine and got
# four columns so narrow that btop refused to run in one. Floating also means
# the scene survives whatever layout the box actually uses. Placement is
# resize-then-move, because resize re-centres a floating window.
#
# EVERYTHING VISIBLE IS STAGED. Neovim edits this widget's own source, the
# listing is this repository, and Files opens a built Home of empty standard
# folders. One caution is printed at the end: btop shows real process names,
# so look at its table before you shoot.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WS=7
HERO="$ROOT/BarWidget.qml"
FAKEHOME="${XDG_RUNTIME_DIR:-/tmp}/td-shoot-home"

need() { command -v "$1" >/dev/null || { echo "shoot: need $1" >&2; exit 1; }; }
need hyprctl; need jq; need foot; need awk

HOME_WS="$(hyprctl activeworkspace -j | jq -r '.id' 2>/dev/null || echo 1)"

if [[ "${1:-}" == "--teardown" ]]; then
  while IFS= read -r a; do
    [[ -n $a ]] || continue
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$a\" })" >/dev/null 2>&1
  done < <(hyprctl clients -j | jq -r --argjson w "$WS" '.[] | select(.workspace.id == $w) | .address')
  echo "workspace $WS cleared"
  exit 0
fi

# The standard scene is landscape; stage it on the largest landscape monitor,
# in that monitor's logical coordinates.
MON="$(hyprctl monitors -j | jq -c 'map(select(.transform % 2 == 0)) | sort_by(-.width) | .[0]')"
LAND="$(jq -r '.name' <<<"$MON")"
read -r MX MY MW MH < <(jq -r '"\(.x) \(.y) \(.width/.scale) \(.height/.scale)"' <<<"$MON")
[[ -n "$LAND" ]] || { echo "shoot: no landscape monitor found" >&2; exit 1; }

hyprctl dispatch "hl.dsp.focus({ monitor = \"$LAND\" })" >/dev/null 2>&1
hyprctl dispatch "hl.dsp.focus({ workspace = $WS })" >/dev/null 2>&1
sleep 0.5

mkdir -p "$FAKEHOME"/{Desktop,Documents,Downloads,Music,Pictures,Public}

count() { hyprctl clients -j | jq --argjson w "$WS" '[.[] | select(.workspace.id == $w)] | length'; }
wait_for() { for _ in $(seq 1 40); do [[ "$(count)" -ge "$1" ]] && return 0; sleep 0.25; done; }
newest() {
  hyprctl clients -j | jq -r --argjson w "$WS" \
    '[.[] | select(.workspace.id == $w)] | sort_by(.focusHistoryID) | .[0].address'
}

# Reference proportions, in the monitor's usable area (under the bar, inside
# the gaps): the editor takes the left 60% and the top 62% of it; the listing
# sits under the editor; btop and Files split the right column 47/53.
G=12; TOP=38
geom() { awk -v mx="$MX" -v my="$MY" -v mw="$MW" -v mh="$MH" -v g="$G" -v top="$TOP" "$1"; }
place() { # addr "awk-expr printing: x y w h"
  local addr="$1"; shift
  read -r X Y W H < <(geom "$1")
  hyprctl dispatch "hl.dsp.window.float({ action = \"on\", window = \"address:$addr\" })" >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.window.resize({ x = $W, y = $H, window = \"address:$addr\" })" >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.window.move({ x = $X, y = $Y, window = \"address:$addr\" })" >/dev/null 2>&1
}
# usable area
U='ux=mx+g; uy=my+top; uw=mw-2*g; uh=mh-top-g;'

if command -v nvim >/dev/null; then
  setsid foot -D "$ROOT" nvim "$HERO" >/dev/null 2>&1 &
else
  setsid foot -D "$ROOT" sh -c "less '$HERO'" >/dev/null 2>&1 &
fi
wait_for 1; sleep 0.6; A_NVIM="$(newest)"
place "$A_NVIM" "BEGIN{$U printf \"%d %d %d %d\", ux, uy, uw*0.60, uh*0.62}"

# btop needs 80 columns; the right column on a laptop-sized monitor does not
# hold 80 at the default font, so this pane runs smaller — which is also how
# dense the reference shot reads.
setsid foot -o "main.font=monospace:size=8" sh -c 'btop || top' >/dev/null 2>&1 &
wait_for 2; sleep 0.6; A_BTOP="$(newest)"
place "$A_BTOP" "BEGIN{$U printf \"%d %d %d %d\", ux+uw*0.60+g, uy, uw*0.40-g, uh*0.47}"

if command -v nautilus >/dev/null; then
  setsid nautilus --new-window "$FAKEHOME" >/dev/null 2>&1 &
else
  setsid foot -D "$FAKEHOME" sh -c 'ls -la; exec sleep 1800' >/dev/null 2>&1 &
fi
wait_for 3; sleep 1.0; A_FILES="$(newest)"
place "$A_FILES" "BEGIN{$U printf \"%d %d %d %d\", ux+uw*0.60+g, uy+uh*0.47+g, uw*0.40-g, uh*0.53-g}"

LS="ls -la"; command -v eza >/dev/null && LS="eza -la --icons --git"
setsid foot -D "$ROOT" sh -c \
  "printf '\\033[32m\$\\033[0m $LS\\n'; $LS; exec sleep 1800" >/dev/null 2>&1 &
wait_for 4; sleep 0.6; A_LS="$(newest)"
place "$A_LS" "BEGIN{$U printf \"%d %d %d %d\", ux, uy+uh*0.62+g, uw*0.60, uh*0.38-g}"

hyprctl dispatch "hl.dsp.focus({ workspace = $HOME_WS })" >/dev/null 2>&1

cat <<EOF
staged: workspace $WS on $LAND — nvim on the widget | btop | Files | listing,
        placed at the standard proportions.

  raise the overlay once you are ON workspace $WS:
      omarchy-shell brownfamilysports.td-palette open
  (or left-click the palette on the bar). Paint a couple of tiles different
  themes first — the shot should show the paint, not just the picker.

  check btop's process table before publishing — it lists real commands.
  tear it down afterwards:  bin/shoot --teardown
EOF
